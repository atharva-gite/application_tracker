# Copy to .env.local for Next.js development.

DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional. Leave unset locally; the app logs instead of sending email.
EMAIL_FROM="Folio <noreply@localhost>"
# RESEND_API_KEY=

# S3-compatible object storage. Required on Vercel so resumes survive deploys.
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION="auto"
# STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# STORAGE_FORCE_PATH_STYLE="false"

# Optional error monitoring. Public DSN is safe for the browser error boundary.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
