# Copy to .env.local for Next.js development.

DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional. Leave unset locally; the app logs instead of sending email.
EMAIL_FROM="Pipeline <noreply@localhost>"
# RESEND_API_KEY=

# Optional error monitoring.
# SENTRY_DSN=
